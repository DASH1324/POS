import jsPDF from 'jspdf';
import autoTable from 'jspdf-autotable';

// Cafe Information
const CAFE_NAME = 'Bleu Bean Cafe';
const CAFE_ADDRESS = 'Quezon City, Metro Manila, Philippines';
const CAFE_CONTACT = 'Tel: (02) 1234-5678 | Email: info@bleubeancafe.com';

// Logo path - adjust this based on your project structure
let logo = null;
try {
  logo = require('../../assets/logo.png');
} catch (error) {
  console.warn('Logo not found, report will generate without logo');
}

/**
 * Converts an image to base64 format for PDF embedding
 * @param {string} url - Image URL
 * @returns {Promise<string>} Base64 string
 */
const getBase64Image = (url) => {
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.crossOrigin = 'Anonymous';
    img.onload = () => {
      const canvas = document.createElement('canvas');
      canvas.width = img.width;
      canvas.height = img.height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0);
      const dataURL = canvas.toDataURL('image/png');
      resolve(dataURL);
    };
    img.onerror = reject;
    img.src = url;
  });
};

/**
 * Adds professional header with logo and cafe information
 * @param {jsPDF} doc - PDF document instance
 * @param {string} logoBase64 - Base64 encoded logo
 */
const addReportHeader = (doc, logoBase64) => {
  const pageWidth = doc.internal.pageSize.width;
  
  // Add logo if available
  if (logoBase64) {
    try {
      doc.addImage(logoBase64, 'PNG', 14, 10, 25, 25);
    } catch (error) {
      console.error('Error adding logo:', error);
    }
  }
  
  // Cafe name and details
  doc.setFontSize(16);
  doc.setFont(undefined, 'bold');
  doc.text(CAFE_NAME, 45, 18);
  
  doc.setFontSize(9);
  doc.setFont(undefined, 'normal');
  doc.setTextColor(100, 100, 100);
  doc.text(CAFE_ADDRESS, 45, 24);
  doc.text(CAFE_CONTACT, 45, 29);
  
  // Horizontal line
  doc.setDrawColor(200, 200, 200);
  doc.line(14, 38, pageWidth - 14, 38);
  
  // Reset text color
  doc.setTextColor(0, 0, 0);
};

/**
 * Adds report title and metadata
 * @param {jsPDF} doc - PDF document instance
 * @param {Object} metadata - Report metadata
 */
const addReportTitle = (doc, metadata) => {
  const pageWidth = doc.internal.pageSize.width;
  
  // Report Title
  doc.setFontSize(14);
  doc.setFont(undefined, 'bold');
  doc.text('CASHIER SALES REPORT', pageWidth / 2, 48, { align: 'center' });
  
  // Report Information Box
  doc.setFillColor(245, 245, 245);
  doc.rect(14, 54, pageWidth - 28, 24, 'F');
  
  doc.setFontSize(10);
  doc.setFont(undefined, 'normal');
  
  const infoY = 62;
  const col1X = 20;
  const col2X = pageWidth / 2 + 10;
  
  // Left column
  doc.setFont(undefined, 'bold');
  doc.text('Cashier:', col1X, infoY);
  doc.text('Report Date:', col1X, infoY + 6);
  
  doc.setFont(undefined, 'normal');
  doc.text(metadata.cashier, col1X + 25, infoY);
  doc.text(metadata.date, col1X + 25, infoY + 6);
  
  // Right column
  doc.setFont(undefined, 'bold');
  doc.text('Order Type:', col2X, infoY);
  doc.text('Product Type:', col2X, infoY + 6);
  
  doc.setFont(undefined, 'normal');
  doc.text(metadata.orderType, col2X + 28, infoY);
  doc.text(metadata.productType, col2X + 28, infoY + 6);
  
  // Generated timestamp
  doc.setFontSize(8);
  doc.setTextColor(120, 120, 120);
  const timestamp = new Date().toLocaleString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    hour12: true
  });
  doc.text(`Generated: ${timestamp}`, col1X, infoY + 13);
  doc.setTextColor(0, 0, 0);
};

/**
 * Adds footer with page numbers and cafe branding
 * @param {jsPDF} doc - PDF document instance
 */
const addReportFooter = (doc) => {
  const pageWidth = doc.internal.pageSize.width;
  const pageHeight = doc.internal.pageSize.height;
  const pageCount = doc.internal.getNumberOfPages();
  
  for (let i = 1; i <= pageCount; i++) {
    doc.setPage(i);
    
    // Footer line
    doc.setDrawColor(200, 200, 200);
    doc.line(14, pageHeight - 20, pageWidth - 14, pageHeight - 20);
    
    // Footer text
    doc.setFontSize(8);
    doc.setFont(undefined, 'normal');
    doc.setTextColor(120, 120, 120);
    
    doc.text(CAFE_NAME, 14, pageHeight - 12);
    doc.text(
      `Page ${i} of ${pageCount}`,
      pageWidth / 2,
      pageHeight - 12,
      { align: 'center' }
    );
    doc.text(
      'Confidential',
      pageWidth - 14,
      pageHeight - 12,
      { align: 'right' }
    );
    
    doc.setTextColor(0, 0, 0);
  }
};

/**
 * Adds a "No Data" message professionally
 * @param {jsPDF} doc - PDF document instance
 * @param {number} yPos - Y position
 * @param {string} message - Message to display
 * @returns {number} New Y position
 */
const addNoDataMessage = (doc, yPos, message = 'No records found for this period') => {
  doc.setFillColor(250, 250, 250);
  doc.rect(14, yPos, doc.internal.pageSize.width - 28, 20, 'F');
  
  doc.setFontSize(9);
  doc.setFont(undefined, 'italic');
  doc.setTextColor(120, 120, 120);
  doc.text(message, doc.internal.pageSize.width / 2, yPos + 12, { align: 'center' });
  doc.setTextColor(0, 0, 0);
  doc.setFont(undefined, 'normal');
  
  return yPos + 28;
};

/**
 * Generates a professional PDF sales report
 * @param {Object} params - Report parameters
 */
export const generateSalesReportPDF = async ({
  loggedInUser,
  formattedDate,
  orderTypeFilter,
  productTypeFilter,
  salesData,
  topProducts,
  cancelledOrders,
  spillageEntries,
  sectionTitles
}) => {
  try {
    const doc = new jsPDF();
    const pageWidth = doc.internal.pageSize.width;
    
    // Load and convert logo to base64
    let logoBase64 = null;
    try {
      logoBase64 = await getBase64Image(logo);
    } catch (error) {
      console.warn('Could not load logo:', error);
    }
    
    // Add header with logo
    addReportHeader(doc, logoBase64);
    
    // Add report title and metadata
    const metadata = {
      cashier: loggedInUser,
      date: formattedDate,
      orderType: orderTypeFilter,
      productType: productTypeFilter
    };
    addReportTitle(doc, metadata);
    
    // Helper function to format values
    const formatMetricValue = (val, format) => {
      if (format === 'currency') {
        const numVal = typeof val === 'string' ? parseFloat(val) : val;
        return `₱${numVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      }
      return val.toLocaleString();
    };
    
    let yPos = 88;
    
    // ===== SALES METRICS SECTION =====
    doc.setFontSize(12);
    doc.setFont(undefined, 'bold');
    doc.setTextColor(0, 0, 0);
    doc.text('Sales Summary', 14, yPos);
    yPos += 6;
    
    const metricsData = [
      ['Total Sales', formatMetricValue(salesData.totalSales || 0, 'currency')],
      ['Cash Sales', formatMetricValue(salesData.cashSales || 0, 'currency')],
      ['GCash Sales', formatMetricValue(salesData.gcashSales || 0, 'currency')],
      ['Items Sold', formatMetricValue(salesData.itemsSold || 0, 'number')]
    ];
    
    autoTable(doc, {
      startY: yPos,
      head: [['Metric', 'Value']],
      body: metricsData,
      theme: 'grid',
      headStyles: { 
        fillColor: [91, 167, 180], 
        fontSize: 10,
        fontStyle: 'bold',
        halign: 'left'
      },
      bodyStyles: {
        fontSize: 10
      },
      columnStyles: {
        0: { fontStyle: 'bold', cellWidth: 100 },
        1: { halign: 'right', fontStyle: 'bold' }
      },
      margin: { left: 14, right: 14 }
    });
    
    yPos = doc.lastAutoTable.finalY + 12;
    
    // ===== TOP PRODUCTS SECTION =====
    // Check if we need a new page
    if (yPos > 220) {
      doc.addPage();
      yPos = 20;
    }
    
    doc.setFontSize(12);
    doc.setFont(undefined, 'bold');
    doc.setTextColor(0, 0, 0);
    doc.text(sectionTitles.topSelling || 'Top Selling Products', 14, yPos);
    yPos += 6;
    
    if (topProducts && topProducts.length > 0) {
      const topProductsData = topProducts.slice(0, 15).map((product, idx) => [
        `#${idx + 1}`,
        product.name,
        product.sales.toString()
      ]);
      
      autoTable(doc, {
        startY: yPos,
        head: [['Rank', 'Product Name', 'Qty Sold']],
        body: topProductsData,
        theme: 'striped',
        headStyles: { 
          fillColor: [91, 167, 180], 
          fontSize: 10,
          fontStyle: 'bold'
        },
        bodyStyles: {
          fontSize: 9
        },
        columnStyles: {
          0: { halign: 'center', cellWidth: 20 },
          1: { cellWidth: 120 },
          2: { halign: 'center', cellWidth: 35 }
        },
        margin: { left: 14, right: 14 }
      });
      
      yPos = doc.lastAutoTable.finalY + 12;
    } else {
      yPos = addNoDataMessage(doc, yPos, 'No product sales recorded for this period');
    }
    
    // ===== CANCELLED ORDERS SECTION =====
    // Check if we need a new page
    if (yPos > 220) {
      doc.addPage();
      yPos = 20;
    }
    
    doc.setFontSize(12);
    doc.setFont(undefined, 'bold');
    doc.setTextColor(0, 0, 0);
    doc.text(sectionTitles.cancelled || 'Cancelled Orders', 14, yPos);
    yPos += 6;
    
    if (cancelledOrders && cancelledOrders.length > 0) {
      const cancelledData = cancelledOrders.map(order => {
        const value = typeof order.value === 'string' ? 
          parseFloat(order.value.replace(/[₱,]/g, '')) : 
          order.value;
        
        return [
          order.time,
          order.product,
          order.qty.toString(),
          formatMetricValue(value, 'currency')
        ];
      });
      
      // Calculate total cancelled value
      const totalCancelled = cancelledOrders.reduce((sum, order) => {
        const value = typeof order.value === 'string' ? 
          parseFloat(order.value.replace(/[₱,]/g, '')) : 
          order.value;
        return sum + value;
      }, 0);
      
      autoTable(doc, {
        startY: yPos,
        head: [['Time', 'Product', 'Qty', 'Value']],
        body: cancelledData,
        foot: [['', 'Total Cancelled:', '', formatMetricValue(totalCancelled, 'currency')]],
        theme: 'striped',
        headStyles: { 
          fillColor: [91, 167, 180], 
          fontSize: 10,
          fontStyle: 'bold'
        },
        bodyStyles: {
          fontSize: 9
        },
        footStyles: {
          fillColor: [220, 237, 240],
          textColor: [91, 167, 180],
          fontStyle: 'bold',
          fontSize: 9
        },
        columnStyles: {
          0: { cellWidth: 30 },
          1: { cellWidth: 90 },
          2: { halign: 'center', cellWidth: 20 },
          3: { halign: 'right', cellWidth: 35 }
        },
        margin: { left: 14, right: 14 }
      });
      
      yPos = doc.lastAutoTable.finalY + 12;
    } else {
      yPos = addNoDataMessage(doc, yPos, 'No cancelled orders for this period');
    }
    
    // ===== SPILLAGE SECTION =====
    // Check if we need a new page
    if (yPos > 220) {
      doc.addPage();
      yPos = 20;
    }
    
    doc.setFontSize(12);
    doc.setFont(undefined, 'bold');
    doc.setTextColor(0, 0, 0);
    doc.text('Spillage & Waste Records', 14, yPos);
    yPos += 6;
    
    if (spillageEntries && spillageEntries.length > 0) {
      const spillageData = spillageEntries.map(entry => [
        entry.timestamp,
        entry.productName,
        entry.category || '-',
        entry.quantity.toString(),
        entry.reason
      ]);
      
      autoTable(doc, {
        startY: yPos,
        head: [['Time', 'Product', 'Category', 'Qty', 'Reason']],
        body: spillageData,
        theme: 'striped',
        headStyles: { 
          fillColor: [91, 167, 180], 
          fontSize: 10,
          fontStyle: 'bold'
        },
        bodyStyles: {
          fontSize: 8
        },
        columnStyles: {
          0: { cellWidth: 28 },
          1: { cellWidth: 50 },
          2: { cellWidth: 25 },
          3: { halign: 'center', cellWidth: 15 },
          4: { cellWidth: 57 }
        },
        margin: { left: 14, right: 14 }
      });
    } else {
      addNoDataMessage(doc, yPos, 'No spillage or waste records for this period');
    }
    
    // Add footer to all pages
    addReportFooter(doc);
    
    // Generate filename
    const dateStr = new Date().toISOString().split('T')[0];
    const filename = `${CAFE_NAME.replace(/\s+/g, '_')}_Sales_Report_${loggedInUser}_${dateStr}.pdf`;
    
    // Save the PDF
    doc.save(filename);
    
    return { success: true, filename };
  } catch (error) {
    console.error('Error generating PDF:', error);
    return { success: false, error: error.message };
  }
};